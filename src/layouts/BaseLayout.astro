---
import "../styles/global.css";
import { styles } from "../styles/styles.tsx";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<html lang="en">
    <head>
        <title>{title}</title>
    </head>

    <body class={styles.layout.page}>
        <slot />
    </body>
</html>